# ── Required ────────────────────────────────────────────────────────────────
# Events. Nothing is found without this. https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Genre tags and listener similarity — the primary scoring signal.
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Setlists and cover attribution. https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=

# ── Artist index ────────────────────────────────────────────────────────────
# Without these the app works but re-analyses every artist on every search.
# Apply supabase/migrations/001_artist_index.sql after creating the project.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── No key needed ───────────────────────────────────────────────────────────
# MusicBrainz (artist identity) and Nominatim (geocoding) require only a
# descriptive User-Agent, set in src/lib/core/env.ts.
