# ── Required ────────────────────────────────────────────────────────────────
# Events. Nothing is found without this. https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Genre tags and listener similarity — the primary scoring signal.
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Setlists and cover attribution. https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=

# ── Artist index ────────────────────────────────────────────────────────────
# Without these the app works but re-analyses every artist on every search,
# which costs roughly half the results: a budget of 30 artists per request
# leaves the rest pending, and a Denver search returns 14 artists cold against
# 31 warm. Apply supabase/migrations/001_artist_index.sql after creating the
# project, then seed it with `npm run backfill -- --acts`.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Set this in Vercel and it authenticates the daily keep-warm cron
# (vercel.json) that stops the free Supabase project being paused and reaped —
# which is how the first index was lost. Without it the route still runs.
CRON_SECRET=

# ── No key needed ───────────────────────────────────────────────────────────
# MusicBrainz (artist identity) and Nominatim (geocoding) require only a
# descriptive User-Agent, set in src/lib/core/env.ts.
